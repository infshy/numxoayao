<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="VolumeControlApp.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:VolumeControlApp.Controls"
    Title="Núm xoay ảo">
    <ContentPage.Resources>
        <Style x:Key="RoundBtn" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#273253" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="8,10" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </ContentPage.Resources>
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0B1020" Offset="0" />
            <GradientStop Color="#1B2347" Offset="0.55" />
            <GradientStop Color="#2B1B4B" Offset="1" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <VerticalStackLayout Padding="20,28" Spacing="20" MaximumWidthRequest="520"
                             HorizontalOptions="Fill" VerticalOptions="Center">
            <VerticalStackLayout Spacing="4">
                <Label Text="🎧  VOLUME CONTROL" FontSize="13" FontAttributes="Bold" CharacterSpacing="3"
                       HorizontalOptions="Center" TextColor="#7FA8FF" />
                <Label Text="{Binding ModeText}" FontSize="25" FontAttributes="Bold"
                       HorizontalOptions="Center" TextColor="White" />
            </VerticalStackLayout>

            <Border StrokeThickness="1" Padding="24,26" StrokeShape="RoundRectangle 30">
                <Border.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#5B8CFF" Offset="0" />
                        <GradientStop Color="#B061FF" Offset="1" />
                    </LinearGradientBrush>
                </Border.Stroke>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#CC1E2646" Offset="0" />
                        <GradientStop Color="#CC141A33" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Shadow>
                    <Shadow Brush="#5B8CFF" Offset="0,8" Radius="36" Opacity="0.3" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="20" HorizontalOptions="Center">
                    <VerticalStackLayout Spacing="0">
                        <Label Text="{Binding VolumeText}" FontSize="58" FontAttributes="Bold"
                               HorizontalOptions="Center" TextColor="White" />
                        <Label Text="ÂM LƯỢNG" FontSize="11" CharacterSpacing="3"
                               HorizontalOptions="Center" TextColor="#8D97AD" />
                    </VerticalStackLayout>

                    <controls:VirtualRotaryKnobView IsVisible="{Binding UseKnob}"
                        Value="{Binding Volume, Mode=TwoWay}"
                        WidthRequest="160" HeightRequest="160" HorizontalOptions="Center" />

                    <VerticalStackLayout IsVisible="{Binding UseSlider}" Spacing="4" WidthRequest="260">
                        <Slider x:Name="VolumeSlider" Minimum="0" Maximum="1"
                                Value="{Binding Volume, Mode=TwoWay}" HeightRequest="40"
                                MinimumTrackColor="#5B8CFF" MaximumTrackColor="#3A4263"
                                ThumbColor="#B061FF" DragCompleted="OnSliderDragCompleted" />
                        <Grid ColumnDefinitions="*,*">
                            <Label Text="0%" TextColor="#8D97AD" FontSize="11" />
                            <Label Grid.Column="1" Text="100%" TextColor="#8D97AD" FontSize="11"
                                   HorizontalTextAlignment="End" />
                        </Grid>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8" WidthRequest="260">
                        <Button Grid.Column="0" Text="−" Command="{Binding StepCommand}" CommandParameter="-1"
                                Style="{StaticResource RoundBtn}" />
                        <Button Grid.Column="1" Text="+" Command="{Binding StepCommand}" CommandParameter="1"
                                Style="{StaticResource RoundBtn}" />
                        <Button Grid.Column="2" Text="{Binding MuteButtonText}" Command="{Binding ToggleMuteCommand}"
                                Style="{StaticResource RoundBtn}" />
                        <Button Grid.Column="3" Text="{Binding PlayButtonText}" Command="{Binding TogglePlayCommand}"
                                Style="{StaticResource RoundBtn}" />
                    </Grid>

                    <Button Text="⇄  Đổi chế độ Knob / Slider" Command="{Binding ToggleModeCommand}"
                            TextColor="White" FontAttributes="Bold" CornerRadius="22" HeightRequest="46">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#4F8CFF" Offset="0" />
                                <GradientStop Color="#A25BFF" Offset="1" />
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
