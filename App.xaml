<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VolumeControl.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="PageBg">#121826</Color>
            <Color x:Key="CardBg">#1E2638</Color>
            <Color x:Key="Accent">#4F8CFF</Color>
            <Color x:Key="TextPrimary">#F2F5FA</Color>
            <Color x:Key="TextMuted">#8D97AD</Color>
        <Style x:Key="MetricName" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
                <Setter Property="FontSize" Value="14" />
            </Style>
            <Style x:Key="MetricValue" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="HorizontalTextAlignment" Value="End" />
            </Style>
        <Style x:Key="RoundBtn" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#262F55" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="HeightRequest" Value="44" />
                <Setter Property="Padding" Value="0" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
